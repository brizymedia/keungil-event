<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        직접 설치판(direct)만 더 갖는 권한. 홈페이지에서 APK 를 받아 까는 판이다.
        구글 플레이는 이 권한들을 기본 문자·전화앱에만 허락하므로 스토어판(play)에는 없다.
        콜백 문자를 안 켜면 이 권한들은 물어보지도 않는다.
    -->
    <!-- 통화가 끝나면 통화기록 맨 윗줄에서 상대 번호를 읽는다 -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- 명함 링크 문자를 앱이 직접 보낸다 (스토어판은 문자앱을 열어 준다) -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 통화 직후 알림으로 물을 때 화면을 덮어 보려는 시도. 안드로이드 14+ 는 전화·알람 앱이 아니면 사용자가 켜 줘야 한다 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

</manifest>
