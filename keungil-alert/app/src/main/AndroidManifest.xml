<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 안드로이드 13 부터는 우리 알림을 띄우는 데도 허락이 필요하다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 배터리 최적화 제외 화면으로 보내기 위해 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        행사 입찰 알림 — 행사 고시 알림판의 공개 JSON 을 하루 한 번 받아온다.
        이 앱이 인터넷을 쓰는 곳은 그것 하나뿐이다. 카톡 내용은 여전히 폰 밖으로 나가지 않는다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        콜백 문자 — 전화를 끊으면 명함 링크를 문자로 보낸다.
        이 권한들은 구글이 제한한 것이라 플레이스토어 등록이 어렵다.
        (직접 배포는 문제 없다.) 콜백을 안 쓰면 물어보지도 않는다.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:label="큰길행사알림"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.KeungilAlert">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="큰길행사알림">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            알림 접근 권한이 필요한 서비스.
            사용자가 설정 → 알림 접근 에서 직접 켜야 동작한다.
        -->
        <service
            android:name=".AlertListenerService"
            android:exported="true"
            android:label="큰길행사알림"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 통화가 끝나면 깨어나 명함 문자를 보낸다 -->
        <receiver
            android:name=".CallWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.brizymedia.keungilalert.CB_SEND" />
                <action android:name="com.brizymedia.keungilalert.CB_SKIP" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
