<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        두 판이 있다 (build.gradle.kts 의 productFlavors).
          스토어판(play)      이 파일의 권한만 쓴다. 문자 보내기 · 통화기록 · 연락처는 구글이 기본 문자·전화앱에만 허락하므로 없다.
                              번호는 아래 CallScreen(전화 확인 앱 역할)으로 받고, 문자는 문자앱을 열어 준다.
          직접 설치판(direct) src/direct/AndroidManifest.xml 이 문자 보내기 · 통화기록 · 연락처 · 전체 화면 알림 권한을 더한다.
    -->

    <!-- 안드로이드 13 부터는 우리 알림을 띄우는 데도 허락이 필요하다 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 배터리 최적화 제외 화면으로 보내기 위해 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        행사 입찰 알림 — 행사 고시 알림판의 공개 JSON 을 하루 한 번 받아온다.
        이 앱이 인터넷을 쓰는 곳은 그것 하나뿐이다. 카톡 내용과 전화번호는 폰 밖으로 나가지 않는다.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 콜백 문자 — 통화가 시작되고 끝나는 것을 알기 위해. 번호는 이것으로는 알 수 없다(안드로이드 9+) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!--
        「모르는 번호에만」을 끄고 주소록 번호에도 물으려는 사람에게만 묻는다(선택).
        상대 번호가 주소록에 있는지 대조만 하고 저장하지 않는다. 스토어판은 이 권한이 있어야 주소록 번호의 전화가 전화 확인 앱에 온다.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        통화가 끝나면 화면 한가운데에 「명함 보낼까요?」 창을 띄운다.
        배경에서 화면을 띄우는 건 안드로이드 10 부터 막혀 있고, 이 권한이 있으면 풀린다.
        사용자가 설정에서 직접 켜야 한다. 안 켜면 알림으로 되돌아간다.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:label="큰길행사알림"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.KeungilAlert">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="큰길행사알림">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            알림 접근 권한이 필요한 서비스.
            사용자가 설정 → 알림 접근 에서 직접 켜야 동작한다. 켜기 전에 앱이 무엇을 읽는지 먼저 알린다(MainActivity).
        -->
        <service
            android:name=".AlertListenerService"
            android:exported="true"
            android:label="큰길행사알림"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            전화 확인(스팸 차단) 앱 역할 — 스토어판이 상대 번호를 받는 길. 사용자가 안드로이드의 물음에 이 앱을 골라야 켜진다.
            전화를 막거나 조용히 하지 않고 번호만 기억한다. 안드로이드 10 이상에서만 묶인다.
        -->
        <service
            android:name=".CallScreen"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- 통화 직후 화면을 덮고 물어보는 창 -->
        <activity
            android:name=".AskActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.KeungilAlert.Ask" />

        <!-- 통화가 끝나면 깨어나 명함 문자를 보낸다 -->
        <receiver
            android:name=".CallWatcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.brizymedia.keungilalert.CB_SKIP" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
