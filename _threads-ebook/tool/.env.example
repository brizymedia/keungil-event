# ── 스레드(필수) ─────────────────────────────
# Meta 개발자 앱 → Threads 사용 사례 → 사용자 토큰 생성기에서 발급
THREADS_ACCESS_TOKEN=
# 비워 두면 me(토큰 주인). npm run whoami 로 숫자 아이디 확인 가능
THREADS_USER_ID=
# token:exchange(짧은 토큰 → 60일 토큰)에만 필요. 앱 설정 → Threads 앱 시크릿 코드
THREADS_APP_SECRET=

# ── 발행 ────────────────────────────────────
POSTS_FILE=posts.json
MAX_PER_RUN=3

# ── 자동 답글(선택) ──────────────────────────
REPLY_KEYWORDS=자료,신청
# 여러 문구는 || 로 구분 → 돌려 가며 사용. {name} = 답글 단 사람 아이디
REPLY_TEMPLATES=@{name} 님 자료 여기 있어요 👉 https://example.com/free || 신청 감사해요 @{name} 님! 링크 드릴게요 👉 https://example.com/free || @{name} 님 도움 되셨으면 좋겠어요 🙏 https://example.com/free
REPLY_MAX_PER_RUN=20
REPLY_GAP_SECONDS=30

# ── AI 원고 생성(선택, npm run generate) ─────
# console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
ACCOUNT_AUDIENCE=퇴근 후 부업을 고민하는 직장인
ACCOUNT_TOPIC=AI로 스레드 글쓰기 · 자동화 · 전자책 수익화
PRODUCT_NAME=전자책 「잠든 사이에도 글이 올라간다」
POST_TIMES=08:10,12:40,20:30
