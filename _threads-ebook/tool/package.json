{
  "name": "threads-autopost",
  "version": "1.0.0",
  "private": true,
  "description": "공식 Threads API 로 스레드 글을 예약 발행하는 도구",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "whoami": "node threads-autopost.mjs whoami",
    "token:exchange": "node threads-autopost.mjs token:exchange",
    "token:refresh": "node threads-autopost.mjs token:refresh",
    "generate": "node threads-autopost.mjs generate",
    "list": "node threads-autopost.mjs list",
    "publish": "node threads-autopost.mjs publish",
    "replies": "node threads-autopost.mjs replies",
    "insights": "node threads-autopost.mjs insights",
    "analyze": "node threads-autopost.mjs analyze"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest"
  }
}
